<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wms_barcode.Home">
        <div class="wms-screen">
            <div class="wms-bar">
                <b>Barcode</b>
                <span class="wms-hint">Scan a transfer barcode or pick an operation</span>
            </div>
            <div t-if="state.msg" class="wms-msg wms-err" t-esc="state.msg"/>
            <div class="wms-cards">
                <button class="wms-card" t-on-click="() => this.openBatches(false)">
                    <div class="wms-card-name">Batch transfers</div>
                    <div class="wms-card-count"><t t-esc="state.counts.batch"/> open</div>
                </button>
                <button class="wms-card" t-on-click="() => this.openBatches(true)">
                    <div class="wms-card-name">Wave transfers</div>
                    <div class="wms-card-count"><t t-esc="state.counts.wave"/> open</div>
                </button>
                <button class="wms-card" t-on-click="openInventory">
                    <div class="wms-card-name">Inventory</div>
                    <div class="wms-hint">Count by scanning</div>
                </button>
                <t t-foreach="state.types" t-as="t" t-key="t.id">
                    <button class="wms-card" t-on-click="() => this.openType(t)">
                        <div class="wms-card-name" t-esc="t.name"/>
                        <div class="wms-card-count"><t t-esc="t.count"/> ready</div>
                        <div t-if="t.late" class="wms-late"><t t-esc="t.late"/> late</div>
                    </button>
                </t>
            </div>
            <div t-if="state.current" class="wms-list">
                <h4 t-esc="state.current.name"/>
                <t t-foreach="state.list" t-as="p" t-key="p.id">
                    <div class="wms-row" t-on-click="() => this.openPicking(p.id)">
                        <b t-esc="p.name"/> <span t-esc="p.partner"/> <small t-esc="p.date"/>
                    </div>
                </t>
                <div t-if="!state.list.length" class="wms-hint">Nothing to do.</div>
            </div>
            <div t-if="state.batches" class="wms-list">
                <h4 t-esc="state.batchTitle"/>
                <t t-foreach="state.batches" t-as="b" t-key="b.id">
                    <div class="wms-row" t-on-click="() => this.openBatch(b.id)">
                        <b t-esc="b.name"/> <span t-esc="b.user"/> <small><t t-esc="b.count"/> transfers</small>
                    </div>
                </t>
                <div t-if="!state.batches.length" class="wms-hint">Nothing to do.</div>
            </div>
        </div>
    </t>

    <t t-name="wms_barcode.Picking">
        <div class="wms-screen">
            <div class="wms-bar">
                <button class="btn btn-light" t-on-click="close">&#8592;</button>
                <b t-esc="state.picking.name"/>
                <span class="wms-hint" t-esc="state.picking.partner"/>
                <span t-if="state.ctx.location_name" class="badge text-bg-info">
                    <t t-esc="state.ctx.location_name"/>
                    <a href="#" t-on-click.prevent="clearContext">&#215;</a>
                </span>
                <span t-if="state.ctx.await_lot" class="badge text-bg-warning">Scan lot/serial</span>
            </div>
            <div t-if="state.msg" t-attf-class="wms-msg {{state.ok ? 'wms-ok' : 'wms-err'}}" t-esc="state.msg"/>
            <button class="btn btn-light" t-on-click="toggleCamera" title="Camera">&#128247;</button>
            <WmsCamera t-if="state.camera" onScan.bind="scan" onClose.bind="toggleCamera"/>
            <input class="form-control wms-input" data-wms-scan="1" placeholder="Scan or type barcode, Enter"
                   t-model="state.manual" t-on-keydown="manualScan"/>
            <table class="table wms-lines">
                <thead><tr><th>Product</th><th>From</th><th>To</th><th class="text-end">Done / Demand</th></tr></thead>
                <tbody>
                    <t t-foreach="state.picking.lines" t-as="l" t-key="l.id">
                        <tr t-att-class="lineClass(l)">
                            <td>
                                <b t-esc="l.product"/>
                                <div t-if="l.description" class="wms-hint" t-esc="l.description"/>
                                <div t-if="l.lots.length" class="wms-hint" t-esc="l.lots.join(', ')"/>
                            </td>
                            <td t-esc="l.locations.join(', ')"/>
                            <td t-esc="l.dest.join(', ')"/>
                            <td class="text-end"><b t-esc="l.done"/> / <t t-esc="l.demand"/> <t t-esc="l.uom"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div class="wms-footer">
                <button class="btn btn-primary btn-lg" t-on-click="validate">Validate</button>
                <button class="btn btn-secondary btn-lg" t-on-click="createWave">Create wave</button>
            </div>
        </div>
    </t>

    <t t-name="wms_barcode.Inventory">
        <div class="wms-screen">
            <div class="wms-bar">
                <button class="btn btn-light" t-on-click="close">&#8592;</button>
                <b>Inventory</b>
                <span t-if="state.ctx.location_name" class="badge text-bg-info" t-esc="state.ctx.location_name"/>
                <span t-if="state.ctx.await_lot" class="badge text-bg-warning">Scan lot/serial</span>
            </div>
            <div t-attf-class="wms-msg {{state.ok ? 'wms-ok' : 'wms-err'}}" t-esc="state.msg"/>
            <button class="btn btn-light" t-on-click="toggleCamera" title="Camera">&#128247;</button>
            <WmsCamera t-if="state.camera" onScan.bind="scan" onClose.bind="toggleCamera"/>
            <input class="form-control wms-input" data-wms-scan="1" placeholder="Scan or type barcode, Enter"
                   t-model="state.manual" t-on-keydown="manualScan"/>
            <table t-if="state.data" class="table wms-lines">
                <thead><tr><th>Product</th><th>Lot</th><th>Package</th>
                    <th class="text-end">On hand</th><th class="text-end">Counted</th><th class="text-end">Diff</th></tr></thead>
                <tbody>
                    <t t-foreach="state.data.lines" t-as="l" t-key="l.id">
                        <tr t-att-class="l.counted === null ? '' : (diff(l) === 0 ? 'wms-done' : 'wms-over')">
                            <td t-esc="l.product"/><td t-esc="l.lot"/><td t-esc="l.package"/>
                            <td class="text-end" t-esc="l.on_hand"/>
                            <td class="text-end" t-esc="l.counted === null ? '-' : l.counted"/>
                            <td class="text-end" t-esc="diff(l)"/>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div t-if="state.data" class="wms-footer">
                <button class="btn btn-primary btn-lg" t-on-click="apply">Apply</button>
                <button class="btn btn-secondary btn-lg" t-on-click="reset">Clear counts</button>
            </div>
        </div>
    </t>

    <t t-name="wms_barcode.Camera">
        <div class="wms-camera">
            <div t-if="state.error" class="wms-msg wms-err" t-esc="state.error"/>
            <video t-ref="video" playsinline="playsinline" muted="muted"/>
            <button class="btn btn-secondary" t-on-click="props.onClose">Close camera</button>
        </div>
    </t>

    <t t-name="wms_barcode.Batch">
        <div class="wms-screen">
            <div class="wms-bar">
                <button class="btn btn-light" t-on-click="close">&#8592;</button>
                <b t-esc="state.batch.name"/>
                <span class="badge text-bg-secondary" t-esc="state.batch.is_wave ? 'Wave' : 'Batch'"/>
                <span class="wms-hint" t-esc="state.batch.pickings.join(', ')"/>
                <span t-if="state.ctx.location_name" class="badge text-bg-info">
                    <t t-esc="state.ctx.location_name"/>
                    <a href="#" t-on-click.prevent="clearContext">&#215;</a>
                </span>
                <span t-if="state.ctx.await_lot" class="badge text-bg-warning">Scan lot/serial</span>
            </div>
            <div t-if="state.msg" t-attf-class="wms-msg {{state.ok ? 'wms-ok' : 'wms-err'}}" t-esc="state.msg"/>
            <button class="btn btn-light" t-on-click="toggleCamera" title="Camera">&#128247;</button>
            <WmsCamera t-if="state.camera" onScan.bind="scan" onClose.bind="toggleCamera"/>
            <input class="form-control wms-input" data-wms-scan="1" placeholder="Scan or type barcode, Enter"
                   t-model="state.manual" t-on-keydown="manualScan"/>
            <table class="table wms-lines">
                <thead><tr><th>Product</th><th>From</th><th>Transfers</th><th class="text-end">Done / Demand</th></tr></thead>
                <tbody>
                    <t t-foreach="state.batch.lines" t-as="l" t-key="l.id">
                        <tr t-att-class="lineClass(l)">
                            <td>
                                <b t-esc="l.product"/>
                                <div t-if="l.description" class="wms-hint" t-esc="l.description"/>
                                <div t-if="l.lots.length" class="wms-hint" t-esc="l.lots.join(', ')"/>
                            </td>
                            <td t-esc="l.locations.join(', ')"/>
                            <td class="wms-hint" t-esc="l.pickings.join(', ')"/>
                            <td class="text-end"><b t-esc="l.done"/> / <t t-esc="l.demand"/> <t t-esc="l.uom"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div class="wms-footer">
                <button class="btn btn-primary btn-lg" t-on-click="validate">Validate</button>
            </div>
        </div>
    </t>
</templates>
